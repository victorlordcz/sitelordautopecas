---
/* Desenhos das áreas de atuação.
   São objetos deste ramo — pistão, martelo de funileiro, leque de cores e
   pistola de pintura — e não ícones genéricos de engrenagem e lata de tinta.

   São silhuetas cheias, e não contornos finos: em tamanho pequeno a forma
   sólida se lê na hora, e o peso combina com o dos títulos.

   O nome vem do campo "icone" de cada item em src/data/site.ts */
interface Props {
  nome: string;
}
const { nome } = Astro.props;

/* Leque: lâminas de canto reto, largas e quase encostando umas nas outras.
   Lâmina fina e de ponta redonda vira dedo; é preciso parecer carta. */
const laminas = [-38, -19, 0, 19, 38];
---

<svg
  class="icone-area"
  width="38"
  height="38"
  viewBox="0 0 32 32"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  {
    nome === 'pistao' && (
      <>
        {/* coroa, com os sulcos dos anéis */}
        <path
          fill-rule="evenodd"
          d="M10.2 3h11.6A2.2 2.2 0 0 1 24 5.2v5.6a2.2 2.2 0 0 1-2.2 2.2H10.2A2.2 2.2 0 0 1 8 10.8V5.2A2.2 2.2 0 0 1 10.2 3Zm-.6 2.9h12.8v1.7H9.6V5.9Zm0 3.1h12.8v1.7H9.6V9Z"
        />
        {/* biela: precisa aparecer, senão a coroa cola no mancal */}
        <path d="M13.4 13h5.2l-.8 8h-3.6z" />
        {/* capa do mancal, com o furo */}
        <path
          fill-rule="evenodd"
          d="M16 20a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 2.8a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4Z"
        />
      </>
    )
  }

  {
    nome === 'martelo' && (
      <>
        {/* cabeça: bloco de canto suave. Terminada em semicírculo
            o conjunto ficava com cara de secador. */}
        <rect x="4.6" y="4.7" width="17.2" height="7.4" rx="2.4" />
        {/* pena em cunha, bem mais fina que a cabeça, para as duas partes
            se distinguirem — e de ponta cega, senão o conjunto vira seta */}
        <path d="M21.8 6.5 26.8 8v1.8l-5 1.5z" />
        {/* cabo, mais grosso que antes para não parecer alfinete */}
        <rect x="12.4" y="12.1" width="5.2" height="16.3" rx="2.2" />
      </>
    )
  }

  {
    nome === 'leque' && (
      <>
        {laminas.map((g) => (
          <rect
            x="13.5"
            y="8.5"
            width="5"
            height="16"
            rx="0.8"
            transform={`rotate(${g} 16 27)`}
          />
        ))}
        {/* rebite que prende o leque — encostando nas lâminas,
            senão fica uma bolinha solta embaixo */}
        <circle cx="16" cy="25.4" r="2.4" />
      </>
    )
  }

  {
    nome === 'pistola' && (
      <>
        {/* bico e corpo */}
        <rect x="5" y="9.5" width="2" height="1.4" rx="0.4" />
        <path d="M10.5 7.8 6.8 9.2v1.9l3.7 1.4z" />
        <rect x="10" y="5.6" width="16.5" height="7.4" rx="2.2" />
        {/* caneca de tinta: larga e curta, senão vira uma perna magra */}
        <path d="M11.5 13h7l-1 7.6h-5z" />
        {/* punho, atrás e inclinado para trás */}
        <path d="M20.8 13h5.4l1.2 13.4h-5.8z" />
      </>
    )
  }
</svg>

<style>
  .icone-area {
    display: block;
  }
</style>
