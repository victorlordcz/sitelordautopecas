---
import { servicos, linkWhatsapp } from '../data/site';
import IconeWhatsapp from './IconeWhatsapp.astro';
import IconeArea from './IconeArea.astro';

const whatsapp = linkWhatsapp();
---

<section class="section" id="servicos">
  <div class="wrap">
    <div class="section-head">
      <h2>{servicos.titulo}</h2>
      <p>{servicos.texto}</p>
    </div>

    <ul class="areas">
      {
        servicos.itens.map((item) => (
          <li class="area">
            <span class="area__icone">
              <IconeArea nome={item.icone} />
            </span>
            <h3>{item.titulo}</h3>
            <p>{item.texto}</p>
          </li>
        ))
      }
    </ul>

    <div class="nota">
      <p>{servicos.rodape}</p>
      <a class="btn btn--outline" href={whatsapp} target="_blank" rel="noopener noreferrer">
        <IconeWhatsapp tamanho={19} />
        Perguntar no WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  /* Faixas com filete no topo, no lugar de cartões soltos:
     lê como índice de catálogo técnico. */
  .areas {
    display: grid;
    gap: 0;
  }

  .area {
    padding-block: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--rule);
  }

  .area:first-child {
    border-top: 2px solid var(--ink);
  }

  .area__icone {
    display: block;
    margin-bottom: 1rem;
    color: var(--ink);
  }

  .area h3 {
    margin-bottom: 0.5rem;
  }

  .area p {
    max-width: 58ch;
    font-size: 1rem;
    line-height: 1.62;
    color: var(--muted);
  }

  /* --- Nota de honestidade + ação --- */
  .nota {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(2rem, 4vw, 2.5rem);
    border-top: 1px solid var(--rule);
  }

  .nota p {
    max-width: 48ch;
    color: var(--muted);
  }

  @media (min-width: 700px) {
    .areas {
      grid-template-columns: repeat(2, 1fr);
      column-gap: clamp(2rem, 5vw, 4rem);
    }

    /* Com duas colunas, as duas primeiras faixas dividem o filete forte. */
    .area:nth-child(2) {
      border-top: 2px solid var(--ink);
    }

    .nota {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2.5rem;
    }
  }

  @media (min-width: 1040px) {
    .areas {
      grid-template-columns: repeat(4, 1fr);
      column-gap: clamp(1.5rem, 3vw, 2.5rem);
    }

    .area,
    .area:nth-child(2) {
      border-top: 2px solid var(--ink);
    }
  }
</style>
